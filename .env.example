# ============ ClaudeAgent 网关配置示例（.env / 环境变量） ============

# 网关对外认证密钥（为空则允许任意请求）
GATEWAY_API_KEY=
# CLAUDE_API_KEY=sk-claude

# 默认模型（未指定 model 时路由目标；建议 Haiku 系列以节省额度）
CLAUDE_DEFAULT_MODEL=claude-haiku-4-5

# 非流式请求默认 max_tokens（Anthropic API 必填）
CLAUDE_DEFAULT_MAX_TOKENS=4096

# 刷新后是否写回 Claude Code 凭据文件（保持 CLI 与网关共用账号状态）
CLAUDE_WRITEBACK=true

# ---- 凭据来源（默认自动探测 ~/.claude/.credentials.json）----
# 凭据文件路径覆盖
# CLAUDE_CREDENTIALS_FILE=%USERPROFILE%\.claude\.credentials.json
# 无头部署（Linux/Docker）时显式指定 refresh token（优先级最高）
# CLAUDE_REFRESH_TOKEN=sk-ant-ort01xxxxx
# OAuth 公开 client_id（默认逆向自 Claude Code 官方 CLI）
# CLAUDE_OAUTH_CLIENT_ID=9d1c250a-e61b-44d9-88ed-5944d1962f5e
# OAuth token 端点
# CLAUDE_OAUTH_TOKEN_URL=https://platform.claude.com/v1/oauth/token

# ---- 上游 ----
# CLAUDE_BASE_URL=https://api.anthropic.com
# CLAUDE_ANTHROPIC_VERSION=2023-06-01
# OAuth 通道必需 beta 头（CLI 同款）
# CLAUDE_ANTHROPIC_BETA=oauth-2025-04-20,claude-code-20250219
# CLAUDE_USER_AGENT=claude-cli/2.1.301 (external, sdk-cli)
# OAuth 通道计费头（CLI 以 system 首块发送；缺失会被归入最严格限流桶 → 全部 429）
# CLAUDE_BILLING_SYSTEM_PROMPT=x-anthropic-billing-header: cc_version=2.1.301.eb5; cc_entrypoint=sdk-cli;
# metadata.user_id 归属（device_id / account_uuid）
# CLAUDE_METADATA_DEVICE_ID=
# CLAUDE_METADATA_ACCOUNT_ID=
# messages 端点查询参数（CLI 同款）
# CLAUDE_MESSAGES_QUERY=beta=true
# CLAUDE_MAX_CONCURRENCY=4
# CLAUDE_MAX_ATTEMPTS=4
# 兜底模型列表（逗号分隔，正常情况由 /v1/models 动态发现）
# CLAUDE_MODELS=claude-haiku-4-5,claude-sonnet-4-5

# ============ Docker / docker compose 部署相关 ============
# 宿主机映射端口（docker-compose.yml 使用）
GATEWAY_PORT=8080
# 网关 token 状态文件路径（容器内挂到可写卷，保证双 Token 永续跨容器重启）
CLAUDE_STATE_FILE=/app/state/claude-agent-state.json
# 容器出网代理（本网络直连 Anthropic 被封；若服务器可直连则留空）
HTTPS_PROXY=http://10.0.5.230:7890
HTTP_PROXY=http://10.0.5.230:7890
NO_PROXY=localhost,127.0.0.1
# 容器内 Claude Code 授权信息：把本机 refresh token 填入（从 ~/.claude/.credentials.json 提取，见 README「Docker 部署」）
# CLAUDE_REFRESH_TOKEN=sk-ant-ort01xxxxxxxx
# CLAUDE_AUTH_SOURCE=Env
# 刷新请求的 scope（与 Claude Code 签发时一致；默认即 CLI 完整 scope 集）
# CLAUDE_OAUTH_SCOPES=user:file_upload user:inference user:mcp_servers user:plugins user:profile user:sessions:claude_code
